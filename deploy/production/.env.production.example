# Copy to /opt/caloriecanvas/.env.production, fill values, and chmod 600.
CALORIE_CANVAS_IMAGE_TAG=live-YYYYMMDD
POSTGRES_USER=caloriecanvas_user
POSTGRES_DB=caloriecanvas
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_URL=postgresql://caloriecanvas_user:replace-with-the-same-url-encoded-password@db:5432/caloriecanvas

NODE_ENV=production
PUBLIC_APP_ORIGIN=https://caloriecanvas.serenx.net
APP_ORIGINS=https://caloriecanvas.serenx.net
SESSION_COOKIE_SECURE=true
DATABASE_SSL=false

BCRYPT_ROUNDS=12
SESSION_COOKIE_NAME=cc_session
CSRF_COOKIE_NAME=cc_csrf
SESSION_TTL_HOURS=168
SESSION_RENEWAL_THRESHOLD_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_MAX=5
PASSWORD_ACTION_RATE_LIMIT_MAX=5

EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-existing-secret
EMAIL_FROM=replace-with-verified-resend-sender
EMAIL_ALLOWED_RECIPIENTS=replace-with-approved-addresses
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=250
