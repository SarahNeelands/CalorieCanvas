# Browser API endpoint. Omit for same-origin /api in hosted builds.
REACT_APP_API_BASE_URL=http://127.0.0.1:3001/api

# Express/PostgreSQL application settings.
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
DATABASE_URL=postgresql://calorie_canvas:change-me@127.0.0.1:5432/calorie_canvas
DATABASE_SSL=false

# Express authentication. Comma-separated origins are allowed.
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BCRYPT_ROUNDS=12
SESSION_COOKIE_NAME=cc_session
CSRF_COOKIE_NAME=cc_csrf
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
SESSION_RENEWAL_THRESHOLD_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_MAX=5
PASSWORD_ACTION_RATE_LIMIT_MAX=5

# Optional, isolated database used only by backend integration tests.
TEST_DATABASE_URL=postgresql://calorie_canvas_test:change-me@127.0.0.1:5433/calorie_canvas_test

# Optional, separate read-only migration tooling. Never expose these to React.
# The source role must have SELECT access and no write privileges.
# Never point the destination at Supabase. Use an isolated rehearsal database first.
SUPABASE_SOURCE_DATABASE_URL=postgresql://readonly-user:change-me@db.project.supabase.co:5432/postgres
MIGRATION_DESTINATION_DATABASE_URL=postgresql://calorie_canvas_migration:change-me@127.0.0.1:5433/calorie_canvas_rehearsal
MIGRATION_ENVIRONMENT=rehearsal
