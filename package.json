{
  "name": "calorie-canvas",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "react-scripts": "^5.0.1",
    "recharts": "^3.2.1",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "local:up": "docker compose -f deploy/local/compose.yml up --build",
    "local:email:up": "docker compose --env-file .env.production --env-file .env.production.local -f deploy/local/compose.yml up --build",
    "local:down": "docker compose -f deploy/local/compose.yml down",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "build:frontend": "react-scripts build",
    "test:frontend": "react-scripts test --watchAll=false",
    "start:backend": "npm --prefix server start",
    "build:backend": "npm --prefix server run build",
    "test:backend": "npm --prefix server test",
    "test:backend:integration": "npm --prefix server run test:integration",
    "migrate:backend": "npm --prefix server run migrate",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
